@bot.callback_query_handler(func=lambda call: call.data.startswith("book_"))
def send_book(call):

    try:
        book_id = int(call.data.split("_")[1])
    except:
        bot.answer_callback_query(
            call.id,
            "❌ Xatolik"
        )
        return

    book = get_book(book_id)

    if not book:
        bot.answer_callback_query(
            call.id,
            "❌ Kitob topilmadi."
        )
        return

    bot.answer_callback_query(
        call.id,
        "📚 Kitob tayyorlanmoqda..."
    )

    caption = (
        f"📖 <b>{book['title']}</b>\n\n"
        f"⬇️ Yuklab olish uchun faylni bosing."
    )

    try:
        bot.send_document(
            call.message.chat.id,
            book["file_id"],
            caption=caption
        )

        increase_download(book_id)

    except Exception as e:

        bot.send_message(
            call.message.chat.id,
            "❌ Kitobni yuborishda xatolik yuz berdi."
        )

        print("SEND BOOK ERROR:", e)


