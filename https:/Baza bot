def is_admin(user_id):
    return user_id == ADMIN_ID


def save_user(user):
    con = db()
    cur = con.cursor()

    cur.execute("""
        INSERT OR REPLACE INTO users
        (user_id, first_name, username, joined_at)
        VALUES (
            ?,
            ?,
            ?,
            COALESCE(
                (SELECT joined_at FROM users WHERE user_id = ?),
                ?
            )
        )
    """, (
        user.id,
        user.first_name or "",
        user.username or "",
        user.id,
        datetime.now().isoformat()
    ))

    con.commit()
    con.close()


def add_book(title, file_id, file_name, uploaded_by):
    con = db()
    cur = con.cursor()

    cur.execute("""
        INSERT INTO books
        (title, file_id, file_name, uploaded_by, created_at)
        VALUES (?, ?, ?, ?, ?)
    """, (
        title,
        file_id,
        file_name,
        uploaded_by,
        datetime.now().isoformat()
    ))

    book_id = cur.lastrowid

    con.commit()
    con.close()

    return book_id


def get_book(book_id):
    con = db()
    cur = con.cursor()

    cur.execute(
        "SELECT * FROM books WHERE id = ?",
        (book_id,)
    )

    book = cur.fetchone()

    con.close()

    return book


def search_books(text):
    con = db()
    cur = con.cursor()

    cur.execute("""
        SELECT * FROM books
        WHERE title LIKE ?
        ORDER BY id DESC
        LIMIT 20
    """, (f"%{text}%",))

    books = cur.fetchall()

    con.close()

    return books


def get_new_books():
    con = db()
    cur = con.cursor()

    cur.execute("""
        SELECT * FROM books
        ORDER BY id DESC
        LIMIT 10
    """)

    books = cur.fetchall()

    con.close()

    return books


def get_popular_books():
    con = db()
    cur = con.cursor()

    cur.execute("""
        SELECT * FROM books
        ORDER BY downloads DESC, id DESC
        LIMIT 10
    """)

    books = cur.fetchall()

    con.close()

    return books


def increase_download(book_id):
    con = db()
    cur = con.cursor()

    cur.execute("""
        UPDATE books
        SET downloads = downloads + 1
        WHERE id = ?
    """, (book_id,))

    con.commit()
    con.close()


def delete_book(book_id):
    con = db()
    cur = con.cursor()

    cur.execute(
        "DELETE FROM books WHERE id = ?",
        (book_id,)
    )

    deleted = cur.rowcount

    con.commit()
    con.close()

    return deleted > 0


