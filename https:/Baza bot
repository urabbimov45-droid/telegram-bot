@bot.callback_query_handler(
    func=lambda call: call.data.startswith("admin_")
)
def admin_callback(call):

    if call.from_user.id != ADMIN_ID:

        bot.answer_callback_query(
            call.id,
            "❌ Ruxsat yo‘q."
        )
        return

    action = call.data

    if action == "admin_stats":

        con = db()
        cur = con.cursor()

        cur.execute("SELECT COUNT(*) FROM users")
        users = cur.fetchone()[0]

        cur.execute("SELECT COUNT(*) FROM books")
        books = cur.fetchone()[0]

        cur.execute(
            "SELECT COALESCE(SUM(downloads), 0) FROM books"
        )
        downloads = cur.fetchone()[0]

        con.close()

        bot.send_message(
            call.message.chat.id,
            "📊 <b>STATISTIKA</b>\n\n"
            f"👤 Foydalanuvchilar: <b>{users}</b>\n"
            f"📚 Kitoblar: <b>{books}</b>\n"
            f"⬇️ Yuklab olishlar: <b>{downloads}</b>"
        )

        bot.answer_callback_query(call.id)

    elif action == "admin_books":

        books = get_new_books()

        if not books:

            bot.send_message(
                call.message.chat.id,
                "📚 Kitoblar bazasi bo‘sh."
            )

        else:

            text = "📚 <b>Kitoblar:</b>\n\n"

            for book in books:

                text += (
                    f"🆔 <code>{book['id']}</code> — "
                    f"{book['title']}\n"
                )

            bot.send_message(
                call.message.chat.id,
                text
            )

        bot.answer_callback_query(call.id)

    elif action == "admin_add":

        msg = bot.send_message(
            call.message.chat.id,
            "📤 PDF fayl yuboring."
        )

        bot.register_next_step_handler(
            msg,
            admin_receive_pdf
        )

        bot.answer_callback_query(call.id)

    elif action == "admin_delete":

        msg = bot.send_message(
            call.message.chat.id,
            "🗑 O‘chirmoqchi bo‘lgan kitob ID raqamini yuboring.\n\n"
            "Masalan: <code>15</code>"
        )

        bot.register_next_step_handler(
            msg,
            admin_delete_book
        )

        bot.answer_callback_query(call.id)


